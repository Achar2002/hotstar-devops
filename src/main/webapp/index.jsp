<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hotstar</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- Navigation -->

    <nav class="navbar">

        <div class="logo">
            STREAM
        </div>

        <div class="nav-links">
            <a href="#">Home</a>
            <a href="#">Movies</a>
            <a href="#">TV Shows</a>
            <a href="#">Sports</a>
        </div>

        <div class="nav-right">
            <input type="text" placeholder="Search">

            <button>Login</button>
        </div>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <div class="hero-content">

            <h1>Unlimited Entertainment</h1>

            <p>
                Watch movies, TV shows, sports and exclusive
                entertainment all in one place.
            </p>

            <button class="watch-button">
                ▶ Watch Now
            </button>

        </div>

    </section>


    <!-- Trending -->

    <section class="content-section">

        <h2>Trending Now</h2>

        <div class="movie-row">

            <div class="movie-card">
                <div class="movie-image">MOVIE 1</div>
                <h3>Action Zone</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 2</div>
                <h3>Dark Night</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 3</div>
                <h3>Lost World</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 4</div>
                <h3>Final Battle</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">MOVIE 5</div>
                <h3>Beyond Space</h3>
            </div>

        </div>

    </section>


    <!-- Latest Shows -->

    <section class="content-section">

        <h2>Latest Shows</h2>

        <div class="movie-row">

            <div class="movie-card">
                <div class="movie-image">SHOW 1</div>
                <h3>City Stories</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">SHOW 2</div>
                <h3>The Detective</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">SHOW 3</div>
                <h3>Family Drama</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">SHOW 4</div>
                <h3>Hidden Truth</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">SHOW 5</div>
                <h3>New Beginning</h3>
            </div>

        </div>

    </section>


    <!-- Sports -->

    <section class="content-section">

        <h2>Sports</h2>

        <div class="movie-row">

            <div class="movie-card">
                <div class="movie-image">CRICKET</div>
                <h3>Cricket Live</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">FOOTBALL</div>
                <h3>Football Live</h3>
            </div>

            <div class="movie-card">
                <div class="movie-image">TENNIS</div>
                <h3>Tennis Championship</h3>
            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <h3>STREAM</h3>

        <p>
            © 2026 Streaming Practice Project
        </p>

    </footer>


    <script src="js/script.js"></script>

</body>

</html>
